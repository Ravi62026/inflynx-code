# Inflynx Agent Provider Credentials (BYOK)
# Never commit your actual API keys to source control!

# OpenRouter API Key (Get at: https://openrouter.ai/keys) - DEFAULT PROVIDER
OPENROUTER_API_KEY=your-openrouter-key-here

# OpenAI API Key (Get at: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-key-here

# Anthropic API Key (Get at: https://console.anthropic.com/)
ANTHROPIC_API_KEY=your-anthropic-key-here

# DeepSeek API Key (Get at: https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=your-deepseek-key-here

# Google Gemini API Key (Get at: https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your-google-api-key-here

# Execution Profile & Provider Defaults
INFLYNX_AGENT_PROVIDER=openrouter
INFLYNX_AGENT_MODEL=openai/gpt-5.6-luna
# Model Thinking / Reasoning Effort: none | minimal | low | medium | high | xhigh | max
INFLYNX_REASONING_EFFORT=none

# How hard the agent works to stay inside the model's context window:
#   off     never touches history (debug aid — long sessions will overflow)
#   evict   drop stale tool output automatically  — DEFAULT, free, lossless for
#           anything the model already acted on
#   compact also fold the oldest turns into a generated summary (costs one model
#           call and changes what the model remembers; opt-in until measured)
# INFLYNX_CONTEXT_STRATEGY=evict

# ─── Database & Cache (Docker Compose: `pnpm docker:up`) ────────────────────
# PostgreSQL is the canonical session/message/tool-execution/telemetry store.
# Without DATABASE_URL set, the app falls back to a non-production local JSON
# file store (@inflynx/session-store LocalJsonSessionStore) — dev/offline only.
POSTGRES_USER=inflynx
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=inflynx_code
POSTGRES_PORT=5432
DATABASE_URL=postgresql://inflynx:change-me-in-production@localhost:5432/inflynx_code

# Redis is used for tool/API rate-limiting and as a forward-compatible event
# pub/sub backbone. Optional — rate limiting no-ops (fails open) if unset.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── Local API / SSE Server Posture (apps/server) ────────────────────────────
# The server can read, write and execute files inside its workspace root, so it
# is loopback-only by default and never lets a request widen its privileges.

# Bind address. Defaults to 127.0.0.1. Any non-loopback value is REFUSED unless
# INFLYNX_SERVER_ALLOW_REMOTE=1 is also set — and authentication/TLS do not exist
# yet, so only do this on a network you fully control.
# HOST=127.0.0.1
# INFLYNX_SERVER_ALLOW_REMOTE=0

# Absolute, path-delimited roots the server may operate inside
# (defaults to the directory it was started from).
# INFLYNX_ALLOWED_ROOTS=/Users/you/projects

# Point the server at a specific workspace; must be inside INFLYNX_ALLOWED_ROOTS.
# INFLYNX_SERVER_WORKSPACE=/Users/you/projects/my-app

# Grant auto-approval of every mutating/shell tool to ALL sessions. Launch-time
# only — requests can never enable this. Leaving it unset is the safe default.
# INFLYNX_AUTO_APPROVE=0

# Browser origins allowed for CORS (comma-separated). Node callers such as the
# VS Code extension host are not subject to CORS. Default: localhost:5173/4173.
# INFLYNX_ALLOWED_ORIGINS=http://localhost:5173