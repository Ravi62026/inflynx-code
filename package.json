{
  "name": "inflynx-code-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Inflynx Code: Advanced Agentic Coding Platform Monorepo",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "dev": "pnpm --filter inflynx-agent run dev",
    "dev:server": "pnpm --filter inflynx-server run dev",
    "dev:vscode": "pnpm --filter inflynx-code run dev",
    "build:vscode": "pnpm --filter inflynx-code run build",
    "package:vscode": "pnpm --filter inflynx-code run package",
    "test": "pnpm --filter inflynx-agent exec tsx ../../tests/run-all-tests.ts",
    "test:unit": "pnpm --filter inflynx-agent exec tsx ../../tests/run-all-tests.ts --unit",
    "test:integration": "pnpm --filter inflynx-agent exec tsx ../../tests/run-all-tests.ts --integration",
    "test:all": "pnpm --filter inflynx-agent exec tsx ../../tests/run-all-tests.ts --all",
    "clean": "pnpm -r run clean",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2"
  }
}
