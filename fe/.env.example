# Portal (fe/) environment — Vite exposes only VITE_*-prefixed vars to the browser.
# Copy to .env.local for local dev. The portal builds and runs fine with these UNSET:
# the /activate page just shows a clear "sign-in is not active yet" state until Clerk is wired.

# Backend origin the device-approve + account calls go to (the CLI's INFLYNX_SERVER_URL peer).
VITE_INFLYNX_API_URL=http://localhost:4000

# Clerk publishable key. Setting this + loading a Clerk client (SDK or script tag) makes /activate
# fully functional with no code change — the page reads the framework-agnostic `window.Clerk` global.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
